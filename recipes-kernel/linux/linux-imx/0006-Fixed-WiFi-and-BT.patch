From cdb73055ae2e937b7ad2d3fcfaa58e65206736fb Mon Sep 17 00:00:00 2001
From: engicam <support@engicam.com>
Date: Wed, 1 Jul 2026 16:05:56 +0200
Subject: [PATCH] Fixed WiFi and BT
Upstream-Status: Pending

diff --git a/arch/arm64/boot/dts/engicam/imx95-smarcore-multimedia-4k.dts b/arch/arm64/boot/dts/engicam/imx95-smarcore-multimedia-4k.dts
index 25b609afdced..c888012c1948 100755
--- a/arch/arm64/boot/dts/engicam/imx95-smarcore-multimedia-4k.dts
+++ b/arch/arm64/boot/dts/engicam/imx95-smarcore-multimedia-4k.dts
@@ -606,12 +606,13 @@ &lpuart8 {
 	/* BT */
 	pinctrl-names = "default";
 	pinctrl-0 = <&pinctrl_uart8>;
-	status = "disabled";
+	status = "okay";
 
 	bluetooth {
 		compatible = "ti,cc33xx-bt";
 		cc33xx-supply = <&reg_usdhc3_vmmc>;
 		max-speed = <115200>;
+		disable-flow-control;
 	};
 };
 
@@ -926,7 +927,6 @@ IMX95_PAD_GPIO_IO34__GPIO5_IO_BIT14			0x31e
 	pinctrl_sai1: sai1grp {
 		fsl,pins = <
 			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_SAI1_RX_DATA_BIT0    0x31e
-			IMX95_PAD_SAI1_TXC__AONMIX_TOP_SAI1_TX_BCLK      0x31e
 			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_SAI1_TX_SYNC     0x31e
 			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_SAI1_TX_DATA_BIT0    0x31e
 		>;
@@ -1119,10 +1119,9 @@ &sai3 {
 };
 
 &gpio1 {
-	status = "okay";
 	gpio-line-names =
 		"", "", "", "", "", "", "", "",
-		"", "", "", "", "WIFI_WAKE#", "", "", "",
+		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "", "", "";
 };
diff --git a/arch/arm64/boot/dts/engicam/imx95-smarcore-smarcore-evb.dts b/arch/arm64/boot/dts/engicam/imx95-smarcore-smarcore-evb.dts
index 7ce59aadbe94..a6c5f00fc600 100644
--- a/arch/arm64/boot/dts/engicam/imx95-smarcore-smarcore-evb.dts
+++ b/arch/arm64/boot/dts/engicam/imx95-smarcore-smarcore-evb.dts
@@ -643,6 +643,7 @@ bluetooth {
 		compatible = "ti,cc33xx-bt";
 		cc33xx-supply = <&reg_usdhc3_vmmc>;
 		max-speed = <115200>;
+		disable-flow-control;
 	};
 };
 
@@ -958,7 +959,6 @@ IMX95_PAD_GPIO_IO34__GPIO5_IO_BIT14			0x31e
 	pinctrl_sai1: sai1grp {
 		fsl,pins = <
 			IMX95_PAD_SAI1_RXD0__AONMIX_TOP_SAI1_RX_DATA_BIT0    0x31e
-			IMX95_PAD_SAI1_TXC__AONMIX_TOP_SAI1_TX_BCLK      0x31e
 			IMX95_PAD_SAI1_TXFS__AONMIX_TOP_SAI1_TX_SYNC     0x31e
 			IMX95_PAD_SAI1_TXD0__AONMIX_TOP_SAI1_TX_DATA_BIT0    0x31e
 		>;
@@ -1169,10 +1169,9 @@ &micfil {
 };
 
 &gpio1 {
-	status = "okay";
 	gpio-line-names =
 		"", "", "", "", "", "", "", "",
-		"", "", "", "", "WIFI_WAKE#", "", "", "",
+		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "", "", "",
 		"", "", "", "", "", "", "", "";
 };
