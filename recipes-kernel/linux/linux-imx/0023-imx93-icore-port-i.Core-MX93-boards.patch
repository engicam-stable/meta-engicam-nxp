+			MX93_PAD_ENET2_TD1__ENET1_RGMII_TD1             	0x1e
+			MX93_PAD_ENET2_TD2__ENET1_RGMII_TD2             	0x1e
+			MX93_PAD_ENET2_TD3__ENET1_RGMII_TD3             	0x1e
+			MX93_PAD_ENET2_TXC__ENET1_RGMII_TXC             	0x1e
