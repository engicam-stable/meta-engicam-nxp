+
+&micfil {
+	#sound-dai-cells = <0>;
+	pinctrl-names = "default";
+	//pinctrl-0 = <&pinctrl_pdm>;
+	assigned-clocks = <&scmi_clk IMX95_CLK_AUDIOPLL1_VCO>,
+					<&scmi_clk IMX95_CLK_AUDIOPLL2_VCO>,
+					<&scmi_clk IMX95_CLK_AUDIOPLL1>,
+					<&scmi_clk IMX95_CLK_AUDIOPLL2>,
+					<&scmi_clk IMX95_CLK_PDM>;
+	assigned-clock-parents = <0>, <0>, <0>, <0>,
+							<&scmi_clk IMX95_CLK_AUDIOPLL1>;
+	assigned-clock-rates = <3932160000>,
+							<3612672000>, <393216000>,
+							<361267200>, <49152000>;
+	status = "disabled";
+};
+
+&gpio1 {
+	status = "okay";
+	gpio-line-names =
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "WIFI_WAKE#", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "";
+};
+
+&gpio2 {
+	gpio-line-names =
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "LCD_BKLT_PWM", "", "", "", "";
+
+		pin_lcd_bklt_pwm{
+			gpio-hog;
+			gpios = <27 0>;
+			output-high;
+		};
+};
+
+&gpio3 {
+	gpio-line-names =
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "";
+};
+
+&gpio4 {
+	gpio-line-names =
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "";
+
+};
+
+&gpio5 {
+	gpio-line-names =
+		"enet1_mdc", "enet1_mdio", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "",
+		"", "", "", "", "", "", "", "";
+
+		ENET1_MDC {
+			gpio-hog;
+			input;
+			gpios = <0 0>;
+			line-name = "enet1_mdc";
