+			gpios = <1 0>;
+			line-name = "enet1_mdio";
+			};
+};
diff --git a/arch/arm64/boot/dts/engicam/imx95-smarcore-xtouch2.dts b/arch/arm64/boot/dts/engicam/imx95-smarcore-xtouch2.dts
new file mode 100644
index 000000000000..effd352f0554
--- /dev/null
+++ b/arch/arm64/boot/dts/engicam/imx95-smarcore-xtouch2.dts
@@ -0,0 +1,997 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
