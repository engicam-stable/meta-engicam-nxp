+		simple-audio-card,cpu {
+				sound-dai = <&sai3>;
+				frame-master;
+				bitclock-master;
+		};
+
+		simple-audio-card,codec {
+				sound-dai = <&sgtl5000>;
+				frame-master;
+				bitclock-master;
+		};
