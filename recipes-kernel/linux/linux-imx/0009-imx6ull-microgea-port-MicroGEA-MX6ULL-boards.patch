+
+		pinctrl_ecspi: ecspigrp {
+			fsl,pins = <
+				MX6UL_PAD_CSI_DATA04__ECSPI1_SCLK      	0x70a1
+				MX6UL_PAD_CSI_DATA05__ECSPI1_SS0 	0x70a1
+				MX6UL_PAD_CSI_DATA06__ECSPI1_MOSI   	0x70a1
