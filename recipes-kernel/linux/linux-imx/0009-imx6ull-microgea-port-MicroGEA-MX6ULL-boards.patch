+/dts-v1/;
+
+#include <dt-bindings/input/input.h>
+#include "../nxp/imx/imx6ull.dtsi"
+
+/ {
+	model = "Engicam MicroGEA MX6ULL SOM Starterkit";
+	compatible = "fsl,imx6ull";
+
+	chosen {
+		stdout-path = &uart1;
+	};
+
+	memory {
+		reg = <0x80000000 0x20000000>;
+	};
