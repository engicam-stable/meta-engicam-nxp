+				MX6UL_PAD_CSI_HSYNC__USDHC2_CMD     0x17058
+				MX6UL_PAD_CSI_DATA00__USDHC2_DATA0  0x17058
+				MX6UL_PAD_CSI_DATA01__USDHC2_DATA1  0x17058
