+				MX6UL_PAD_CSI_DATA03__USDHC2_DATA3  0x17058
+			>;
+		};
+
+
+		pinctrl_i2c1: i2c1grp {
+			fsl,pins = <
+				MX6UL_PAD_CSI_PIXCLK__I2C1_SCL 0x4001b8b0
+				MX6UL_PAD_CSI_MCLK__I2C1_SDA 0x4001b8b0
