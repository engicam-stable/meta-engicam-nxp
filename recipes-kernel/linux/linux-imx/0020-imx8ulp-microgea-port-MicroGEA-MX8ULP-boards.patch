 .../boot/dts/freescale/imx8ulp-rpmsg.dtsi     |  12 +
 6 files changed, 1203 insertions(+), 15 deletions(-)
 delete mode 100644 arch/arm64/boot/dts/engicam/Makefile.rej
 create mode 100644 arch/arm64/boot/dts/engicam/imx8ulp-microgea-loco5.dts
 create mode 100644 arch/arm64/boot/dts/engicam/imx8ulp-microgea-microdev-lcd7.dts
 create mode 100644 arch/arm64/boot/dts/engicam/imx8ulp-microgea-microdev-rev3.dts

