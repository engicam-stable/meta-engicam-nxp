+    uint32_t clockId;         /*!< Clock ID */
+    uint32_t perLpiId;        /*!< Peripheral LPI ID */
+    uint32_t baud;            /*!< Baud rate */
+    uint8_t inst;             /*!< Instance number */
+} board_uart_config_t;
+
+#if defined(__cplusplus)
