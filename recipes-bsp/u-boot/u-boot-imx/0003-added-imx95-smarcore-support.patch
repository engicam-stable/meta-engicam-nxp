+
+	imx9_scmi_power_domain_enable(IMX95_PD_DISPLAY, false);
+	imx9_scmi_power_domain_enable(IMX95_PD_CAMERA, false);
+
+#if defined(CONFIG_USB_TCPC)
+	setup_typec();
+#endif
+
+	netc_init();
+
+	flexspi_nor_steup();
+
+	//power_on_m7("mx95evkrpmsg");
+
+	//lvds_backlight_on();
+
+	return 0;
+}
