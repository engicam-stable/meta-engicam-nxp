 board/engicam/imx95_smarcore/imx95_smarcore.c | 658 ++++++++++++++++++
 .../engicam/imx95_smarcore/imx95_smarcore.env | 150 ++++
 board/engicam/imx95_smarcore/spl.c            | 123 ++++
