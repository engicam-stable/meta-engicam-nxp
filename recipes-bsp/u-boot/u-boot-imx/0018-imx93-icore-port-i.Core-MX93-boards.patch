From 6210cdea7a3445c4be141b0d8be5044299c4a894 Mon Sep 17 00:00:00 2001
From: engicam <support@engicam.com>
Date: Thu, 9 Jul 2026 14:57:35 +0200
Subject: [PATCH] imx93-icore: port i.Core MX93 boards
Upstream-Status: Inappropriate [for engicam use only]

---
 arch/arm/dts/imx93-icore-u-boot.dtsi          |  209 ++
 arch/arm/dts/imx93-icore.dts                  |  447 ++++
 arch/arm/mach-imx/imx9/Kconfig                |    6 +
 arch/arm/mach-imx/imx9/Kconfig.rej            |   10 -
 board/engicam/imx93_icore/Kconfig             |   26 +
 board/engicam/imx93_icore/Makefile            |   17 +
 board/engicam/imx93_icore/imx93_icore.c       |  114 +
 .../engicam/imx93_icore/lpddr4x_1gb_timing.c  | 1999 +++++++++++++++++
 board/engicam/imx93_icore/lpddr4x_timing.c    | 1488 ++++++++++++
 board/engicam/imx93_icore/spl.c               |  166 ++
 configs/imx93_icore_1gb_defconfig             |  149 ++
 configs/imx93_icore_defconfig                 |  149 ++
 drivers/ddr/imx/imx9/Kconfig                  |    6 +
 include/configs/imx93_icore.h                 |  175 ++
 14 files changed, 4951 insertions(+), 10 deletions(-)
