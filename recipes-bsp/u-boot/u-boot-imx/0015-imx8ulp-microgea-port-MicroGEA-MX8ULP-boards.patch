@@ -0,0 +1,15 @@
+# SPDX-License-Identifier: GPL-2.0+
+
+obj-y   += imx8ulp_microgea.o
+obj-y += ../../freescale/common/
+
+ifdef CONFIG_SPL_BUILD
+obj-y += spl.o
+obj-$(CONFIG_TARGET_IMX8ULP_9X9_EVK) += lpddr4_timing_9x9.o
+ifdef CONFIG_IMX8ULP_ND_MODE
