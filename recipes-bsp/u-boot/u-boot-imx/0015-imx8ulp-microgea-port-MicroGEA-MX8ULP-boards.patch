 	select SPL_CRYPTO if SPL
 
+config TARGET_IMX8ULP_MICROGEA
+	bool "imx8ulp_microgea"
+	select IMX8ULP
+	select SUPPORT_SPL
+	select IMX8ULP_DRAM
+	select FSL_CAAM
+	select FSL_BLOB
+	select MISC
+	select ARCH_MISC_INIT
+	select SPL_CRYPTO if SPL
+
 endchoice
 
+source "board/engicam/imx8ulp_microgea/Kconfig"
 source "board/freescale/imx8ulp_evk/Kconfig"
 source "board/freescale/imx8ulp_watch/Kconfig"
 
